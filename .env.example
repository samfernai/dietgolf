# Postgres connection string.
# Local dev (docker compose up -d):
DATABASE_URL="postgresql://dietgolf:dietgolf@localhost:5432/dietgolf"

# Cloud Run + Cloud SQL (unix socket) example:
# DATABASE_URL="postgresql://dietgolf:PASSWORD@localhost/dietgolf?host=/cloudsql/PROJECT:REGION:INSTANCE"

# Managed Postgres (Neon / Supabase) example:
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# 32+ char random string used to sign session cookies.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: pin the first day of the season (an ISO Monday). Defaults to the
# Monday of the week the app first runs.
# SEASON_START="2026-01-05"
